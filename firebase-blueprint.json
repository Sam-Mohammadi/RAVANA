{
  "entities": {
    "UserSession": {
      "title": "UserSession",
      "description": "Saved therapy simulation session records for a student",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "caseId": { "type": "string" },
        "caseName": { "type": "string" },
        "createdAt": { "type": "string" },
        "duration": { "type": "number" },
        "messageCount": { "type": "number" },
        "clinicalNotes": { "type": "string" }
      },
      "required": ["id", "userId", "caseId", "createdAt"]
    },
    "ReflectiveJournal": {
      "title": "ReflectiveJournal",
      "description": "Clinical reflective journal entry written by student",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string" },
        "content": { "type": "string" },
        "sessionDuration": { "type": "number" }
      },
      "required": ["id", "userId", "title", "createdAt", "content"]
    },
    "ClinicalCase": {
      "title": "ClinicalCase",
      "description": "Custom clinical scenario created by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientName": { "type": "string" },
        "age": { "type": "number" },
        "gender": { "type": "string" },
        "occupation": { "type": "string" },
        "dsmDiagnosis": { "type": "string" },
        "coreBeliefs": { "type": "string" },
        "clinicalBackground": { "type": "string" }
      },
      "required": ["id", "patientName", "dsmDiagnosis"]
    }
  },
  "firestore": {
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "UserSession",
      "description": "User saved simulation sessions"
    },
    "/users/{userId}/journals/{journalId}": {
      "schema": "ReflectiveJournal",
      "description": "User clinical reflective journal entries"
    },
    "/users/{userId}/cases/{caseId}": {
      "schema": "ClinicalCase",
      "description": "User created custom clinical cases"
    }
  }
}
